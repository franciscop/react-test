{
  "name": "react-test",
  "version": "0.28.3",
  "description": "Expressive testing library for React to make sure your code works as expected. Write better code, ship fewer bugs.",
  "homepage": "https://react-test.dev/",
  "repository": "github:franciscop/react-test",
  "author": "Francisco Presencia <public@francisco.io> (https://francisco.io/)",
  "funding": "https://www.paypal.me/franciscopresencia/19",
  "license": "MIT",
  "keywords": [
    "react",
    "test",
    "testing",
    "render",
    "events",
    "jest",
    "vitest"
  ],
  "scripts": {
    "build": "npm run build:library && npm run build:types && npm run build:prettier",
    "build:library": "vite build && mv dist/index.min.js . && rm -rf dist",
    "build:types": "dts-bundle-generator --external-types 'react,react-dom' --export-referenced-types false --out-file index.d.ts src/index.ts && cat src/jest-matchers/types.d.ts >> index.d.ts",
    "build:prettier": "prettier --write src *.ts *.json",
    "lint": "oxlint src && tsc",
    "size": "echo $(gzip -c index.min.js | wc -c) bytes",
    "start": "vitest",
    "test": "vitest run --coverage",
    "test:demo": "npm run build:library && node demo/test.js"
  },
  "main": "index.min.js",
  "type": "module",
  "types": "index.d.ts",
  "files": [
    "index.d.ts"
  ],
  "documentation.page": {
    "title": "🧯 React Test - Expressive testing library for React",
    "home": "assets/home.html",
    "menu": {
      "Documentation": "/documentation",
      "Donate": "https://www.paypal.me/franciscopresencia/19",
      "Author": "https://francisco.io/",
      "Github": "https://github.com/franciscop/react-test"
    },
    "pages": [
      "readme.md",
      "src/methods",
      "src/helpers",
      "src/jest-matchers",
      "src/examples"
    ]
  },
  "devDependencies": {
    "@endosome/dts-bundle-generator": "9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
